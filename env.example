# Copy to .env.local for local development:  cp .env.example .env.local
# (On Vercel, add these under Project -> Settings -> Environment Variables.)

# ---------------- Redis ----------------
# Easiest: create "Upstash for Redis" in Vercel (Storage tab -> Connect to Project), then run:
#     vercel link && vercel env pull .env.local
# which fills in the two values below automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatives (only one Redis is used; REST above wins):
#   UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
#   REDIS_URL=redis://localhost:6379
# If NOTHING is set, local dev falls back to a JSON file in ./.data (never on Vercel).

# ---------------- Google sign-in ----------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorized redirect URIs:  http://localhost:3000/api/auth/google/callback
#                              https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------- Admin access ----------------
# Google accounts (verified email) that become admins, comma-separated:
ADMIN_EMAILS=
# Optional password login for the admin panel. CHOOSE A LONG RANDOM PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------- Misc ----------------
# Public URL of the site (used to build the Google redirect URI). Optional locally.
APP_URL=
PORT=3000
